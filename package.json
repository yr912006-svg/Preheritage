{
  "name": "preheritage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test:browser": "playwright test",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-test-loader.mjs --test src/lib/*.test.mjs",
    "test:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-test-loader.mjs --test test/integration",
    "test:integration:prepare": "node scripts/razorpay-integration-db.mjs prepare",
    "browser-qa:setup": "node scripts/browser-qa-fixtures.mjs setup",
    "browser-qa:status": "node scripts/browser-qa-fixtures.mjs status",
    "browser-qa:cleanup": "node scripts/browser-qa-fixtures.mjs cleanup",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-presigned-post": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@prisma/client": "^5.14.0",
    "@types/three": "^0.187.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "files-sdk": "^3.1.2",
    "lucide-react": "^0.469.0",
    "next": "^15.5.28",
    "next-auth": "^4.24.7",
    "razorpay": "^2.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.32",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
