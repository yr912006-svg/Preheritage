# =============================================================================
# PREHERITAGE - ENVIRONMENT VARIABLES CONFIGURATION
# Wear the Stories of India | preheritage.com
# =============================================================================

# 1. APPLICATION & DOMAIN
NEXT_PUBLIC_APP_URL="https://preheritage.com"
NEXT_PUBLIC_SITE_NAME="PREHERITAGE"
NEXT_PUBLIC_SITE_TAGLINE="Wear the Stories of India"
NEXT_PUBLIC_SITE_PHILOSOPHY="Don't Just Wear Heritage. Carry It Forward."
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# 2. DATABASE (Neon PostgreSQL)
# Use Neon's pooled DATABASE_URL for app requests and DATABASE_URL_UNPOOLED for Prisma schema operations.
DATABASE_URL="postgresql://[YOUR_POSTGRES_USER]:[YOUR_POSTGRES_PASSWORD]@[YOUR_POSTGRES_HOST]/[YOUR_DATABASE]?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://[YOUR_POSTGRES_USER]:[YOUR_POSTGRES_PASSWORD]@[YOUR_POSTGRES_HOST]/[YOUR_DATABASE]?sslmode=require"

# 3. NEON OBJECT STORAGE (injected by `neon env pull` for the current branch)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""

# 3. NEXTAUTH / AUTH.JS
NEXTAUTH_URL="https://preheritage.com"
NEXTAUTH_SECRET="[YOUR_NEXTAUTH_SECRET_GENERATE_WITH_OPENSSL_RAND_BASE64_32]"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="[YOUR_GOOGLE_CLIENT_ID].apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="[YOUR_GOOGLE_CLIENT_SECRET]"

# Admin Authentication
ADMIN_INITIAL_EMAIL="[YOUR_ADMIN_EMAIL]"
ADMIN_INITIAL_PASSWORD="[GENERATE_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS]"

# 4. MOBILE OTP AUTHENTICATION (Twilio / MSG91 / Fast2SMS)
OTP_PROVIDER="FAST2SMS" # Options: FAST2SMS, MSG91, TWILIO, MOCK
FAST2SMS_API_KEY="[YOUR_FAST2SMS_API_KEY]"
MSG91_AUTH_KEY="[YOUR_MSG91_AUTH_KEY]"
MSG91_TEMPLATE_ID="[YOUR_MSG91_TEMPLATE_ID]"
TWILIO_ACCOUNT_SID="[YOUR_TWILIO_ACCOUNT_SID]"
TWILIO_AUTH_TOKEN="[YOUR_TWILIO_AUTH_TOKEN]"
TWILIO_PHONE_NUMBER="[YOUR_TWILIO_PHONE_NUMBER]"

# 5. INDIAN PAYMENT GATEWAY: RAZORPAY
RAZORPAY_KEY_ID="[YOUR_RAZORPAY_KEY_ID]"
RAZORPAY_KEY_SECRET="[YOUR_RAZORPAY_KEY_SECRET]"
RAZORPAY_WEBHOOK_SECRET="[YOUR_RAZORPAY_WEBHOOK_SECRET]"
NEXT_PUBLIC_RAZORPAY_KEY_ID="[YOUR_RAZORPAY_KEY_ID]"

# 6. INTERNATIONAL PAYMENTS: STRIPE (Optional)
STRIPE_SECRET_KEY="[YOUR_STRIPE_SECRET_KEY]"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="[YOUR_STRIPE_PUBLISHABLE_KEY]"
STRIPE_WEBHOOK_SECRET="[YOUR_STRIPE_WEBHOOK_SECRET]"

# 7. MEDIA STORAGE & IMAGE UPLOADS: CLOUDINARY or VERCEL BLOB
CLOUDINARY_CLOUD_NAME="[YOUR_CLOUDINARY_CLOUD_NAME]"
CLOUDINARY_API_KEY="[YOUR_CLOUDINARY_API_KEY]"
CLOUDINARY_API_SECRET="[YOUR_CLOUDINARY_API_SECRET]"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="[YOUR_CLOUDINARY_CLOUD_NAME]"
BLOB_READ_WRITE_TOKEN="[YOUR_VERCEL_BLOB_TOKEN]"

# 8. SHIPPING & COURIER PARTNER (Shiprocket)
SHIPROCKET_EMAIL="[YOUR_SHIPROCKET_EMAIL]"
SHIPROCKET_PASSWORD="[YOUR_SHIPROCKET_PASSWORD]"
SHIPROCKET_API_URL="https://apiv2.shiprocket.in/v1/external"

# 9. NOTIFICATIONS & EMAIL (Resend or Sendgrid)
RESEND_API_KEY="[YOUR_RESEND_API_KEY]"
SUPPORT_EMAIL="care@preheritage.com"
WHATSAPP_SUPPORT_NUMBER="919876543210"

# 10. MARKETING & ANALYTICS
NEXT_PUBLIC_GA_TRACKING_ID="G-[YOUR_GA4_MEASUREMENT_ID]"
NEXT_PUBLIC_META_PIXEL_ID="[YOUR_META_PIXEL_ID]"
